{
  "name": "guiderail",
  "version": "0.5.0",
  "private": true,
  "description": "Save, revisit and export ChatGPT replies as local Markdown notes.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/third-party-notices.mjs && node scripts/check-build.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:history": "node scripts/check-privacy.mjs --history",
    "release:local": "npm run check:privacy && npm test && npm run build && node scripts/package-release.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.6",
    "jsdom": "25.0.1",
    "postcss": "8.5.28",
    "typescript": "~5.7.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0"
  }
}
